{
  "conclusion": {
    "body": "<div class='cbox'>\n\n$0\n\n</div>\n\n",
    "prefix": "conclusion"
  },
  "process": {
    "body": "<div class='pbox'>\n\n$0\n\n</div>\n\n",
    "prefix": "proc"
  },
  "def": {
    "body": "<div class='dbox'>\n\n$0\n\n</div>\n\n",
    "prefix": "def"
  },
  "bbox": {
    "body": "<div class='bbox'>\n\n$0\n\n</div>\n\n",
    "prefix": "bbox"
  },
  "think": {
    "body": "[think] $0",
    "prefix": "think"
  },
  "header": {
    "body": [
      "---",
      "title: $1",
      "tags: [$2]",
      "---",
      "# $1",
      "$0"
    ],
    "prefix": "header"
  }
}
